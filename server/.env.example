# ── CivicPulse backend environment ──────────────────────────────
# Copy this file to ".env" and fill in real values.

# Port the Express server listens on (defaults to 5000 if unset)
PORT=5000

# MongoDB Atlas connection string.
# Replace YOUR_USERNAME / YOUR_PASSWORD / YOUR_CLUSTER / YOUR_DATABASE.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER/YOUR_DATABASE?retryWrites=true&w=majority

# Long random string used to sign JWTs (use `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_long_random_secret

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173
